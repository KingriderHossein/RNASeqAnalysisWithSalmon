{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RNA-seq Download Manager",
  "version": "0.1.6",
  "identifier": "org.rnaseq.modulea",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "RNA-seq Download Manager", "width": 1240, "height": 820, "minWidth": 900, "minHeight": 650 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'" }
  },
  "bundle": { "active": false }
}
